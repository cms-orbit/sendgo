{
    "name": "cms-orbit/sendgo",
    "version": "4.3.1",
    "description": "Orbit SendGo integration: admin GUI, template sync, campaign records, and phone verification.",
    "keywords": [
        "laravel",
        "cms",
        "orbit",
        "sendgo",
        "sms",
        "kakao",
        "alimtalk"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "cms-orbit/core": "^4.6",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "techigh/sendgo-notification": "^1.2"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "CmsOrbit\\Sendgo\\": "src/",
            "CmsOrbit\\Sendgo\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CmsOrbit\\Sendgo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CmsOrbit\\Sendgo\\SendgoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "lock": false,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ]
    }
}
